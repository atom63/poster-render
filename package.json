{
  "name": "poster-render",
  "version": "1.0.0",
  "description": "A Node.js CLI for rendering Xiaohongshu-style poster slides from structured JSON.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atom63/poster-render.git"
  },
  "homepage": "https://github.com/atom63/poster-render#readme",
  "bugs": {
    "url": "https://github.com/atom63/poster-render/issues"
  },
  "keywords": [
    "cli",
    "poster",
    "carousel",
    "xiaohongshu",
    "xhs",
    "png",
    "rendering",
    "markdown"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "poster-render": "./render.js"
  },
  "files": [
    "render.js",
    "src/",
    "preview/",
    "README.md",
    "LICENSE",
    "docs/assets/reference",
    "examples/sample-content.json",
    "examples/sample-markdown.md"
  ],
  "scripts": {
    "help": "node render.js --help",
    "render": "node render.js content.json",
    "sample": "node render.js examples/sample-content.json --output ./output-sample",
    "preview": "node preview/preview.mjs examples/sample-content.json --output ./preview.html",
    "preview:dev": "node preview/dev-server.mjs examples/sample-content.json",
    "preview:minimal": "node preview/dev-server.mjs examples/sample-content.json --template minimal",
    "preview:bold": "node preview/dev-server.mjs examples/sample-content.json --template bold",
    "preview:technical": "node preview/dev-server.mjs examples/sample-content.json --template technical",
    "preview:export": "node preview/export-png.mjs examples/sample-content.json --output ./preview-export",
    "markdown:content": "node markdown-to-content.js",
    "lint": "node --check render.js && node --check src/render-cover.js && node --check src/render-pagination.js && node --check src/render-emoji.js && node --check src/render-image.js && node --check src/render-pattern.js && node --check src/render-config.js && node --check src/render-segments.js && node --check src/render-table.js && node --check src/markdown-to-content.js && node --check preview/preview.mjs && node --check preview/export-png.mjs && node --check preview/render-blocks.mjs && node --check preview/render-slide.mjs",
    "test": "node --test test/*.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["canvas"]
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "canvas": "^3.2.3",
    "playwright": "^1.55.0",
    "shiki": "^4.0.2"
  }
}
